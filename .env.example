# ---------------------------------------------------------------------------
# Base
# ---------------------------------------------------------------------------
# Base PostgreSQL appartenant à Data Genius (comptes, analyses et schéma warehouse).
DATABASE_URL=postgresql://datagenius_app:mot_de_passe@127.0.0.1:5432/datagenius
# Même base, avec un rôle limité à la lecture de warehouse.snapshots.
DATAGENIUS_WAREHOUSE_READ_URL=postgresql://datagenius_warehouse_reader:mot_de_passe@127.0.0.1:5432/datagenius
# Adresse publique de l'application (sans barre finale).
NEXTAUTH_URL=http://localhost:3120
# Adresse publique utilisée dans les liens des e-mails (repli : NEXTAUTH_URL).
# APP_URL=https://datagenius.example.com
# Fuseau horaire d'affichage des dates (nom IANA).
# NEXT_PUBLIC_TIMEZONE=Africa/Abidjan

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Secret de signature des sessions, 32 caractères minimum. Génération : openssl rand -base64 48
NEXTAUTH_SECRET=

# Nombre de sauts de proxy de confiance devant l'application (répartiteur, proxy inverse, CDN), de 0 à 10.
# 0 ou absent : les en-têtes x-forwarded-for / x-real-ip sont ignorés et seule la limite de connexion
# par e-mail s'applique. Voir docs/securite-connexion.md.
# DATAGENIUS_PROXY_DE_CONFIANCE=1

# ---------------------------------------------------------------------------
# OpenID Connect (optionnel : fournisseur d'identité de l'entreprise)
# ---------------------------------------------------------------------------
# DATAGENIUS_OIDC_ISSUER=https://identite.example.com
# DATAGENIUS_OIDC_CLIENT_ID=datagenius
# DATAGENIUS_OIDC_CLIENT_SECRET=
# Script de liaison d'une identité à un compte existant (scripts/liaison-oidc.ts) :
# DATAGENIUS_OIDC_SUBJECT=
# DATAGENIUS_OIDC_EMAIL=

# ---------------------------------------------------------------------------
# Sources de données et warehouse
# ---------------------------------------------------------------------------
# Clé hexadécimale de 32 octets (64 caractères) qui chiffre les connexions ajoutées dans l'interface.
# Génération : openssl rand -hex 32. À conserver HORS du serveur : sa perte rend les connexions irrécupérables.
DATAGENIUS_SOURCE_KEY=
# Catalogue facultatif pour la recette et les configurations précédentes.
# DATAGENIUS_CATALOGUE=config/demo-postgresql.json
# Une variable par source. Les noms sont référencés dans le catalogue administrateur.
DATAGENIUS_SOURCE_DISTRIBUTION=postgresql://datagenius_reader:mot_de_passe@127.0.0.1:5432/distribution
DATAGENIUS_SOURCE_SUPPORT=postgresql://datagenius_support_reader:mot_de_passe@127.0.0.1:5432/support
# Origines REST privées autorisées malgré le blocage des adresses internes, séparées par des virgules.
# DATAGENIUS_REST_ORIGINES_PRIVEES=https://api.interne.example
# Hôtes ou IP, séparés par des virgules, autorisés pour les sources PostgreSQL/MySQL même s'ils sont privés ou locaux.
# Même valeur pour l'application et le worker (ex. 127.0.0.1 pour une base locale).
# DATAGENIUS_SOURCES_HOTES_AUTORISES=127.0.0.1

# ---------------------------------------------------------------------------
# Intégration
# ---------------------------------------------------------------------------
# Origines autorisées à intégrer un tableau, séparées par des virgules.
# DATAGENIUS_EMBED_ORIGINS=https://portail.example

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# true pour TLS direct (port 465), false pour STARTTLS.
# SMTP_SECURE=false
# Adresse d'expédition.
# MAIL_FROM="Data Genius <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Fichiers et tâches planifiées
# ---------------------------------------------------------------------------
# Dossier des fichiers téléversés (en production : volume persistant).
# UPLOAD_DIR=/var/lib/datagenius/uploads
# Dossier de polices PDF de remplacement pour les exports (Roboto est fourni).
# MEDIC_ASSIST_POLICES_PDF=/var/lib/datagenius/polices
# Jeton qui autorise l'appel des tâches planifiées, 32 caractères minimum. Génération : openssl rand -hex 32
# JETON_TACHES_PLANIFIEES=

# ---------------------------------------------------------------------------
# Intelligence artificielle (renseigner au moins un fournisseur)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# POSTGRES_USER=datagenius_app
# POSTGRES_PASSWORD=
# POSTGRES_DB=datagenius

# ---------------------------------------------------------------------------
# Création d'un utilisateur (npm run user:create)
# ---------------------------------------------------------------------------
# DATAGENIUS_USER_EMAIL=admin@example.com
# DATAGENIUS_USER_NAME=Administrateur
# DATAGENIUS_USER_PASSWORD=
# DATAGENIUS_USER_ROLE=Member

# ---------------------------------------------------------------------------
# Recettes PostgreSQL / MySQL (CI et poste de développement)
# ---------------------------------------------------------------------------
# Dossier des binaires PostgreSQL utilisés par npm run test:postgres.
# PG_BIN=/usr/lib/postgresql/16/bin
